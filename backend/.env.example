PORT=5000
# Recebimento de compras e geração de parcelas usam transações MongoDB; use Atlas ou replica set local.
MONGO_URI=mongodb://localhost:27017/sienge?replicaSet=rs0
# Configure um segredo aleatorio de pelo menos 32 caracteres no ambiente do servico.
# Rotacione substituindo-a no Render e fazendo redeploy; os tokens assinados anteriormente deixam de valer.
JWT_SECRET=
JWT_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173,https://erp-construtora-pog1.onrender.com
# Opcional na inicializacao; configure a URL publica para links de convite e recuperacao.
FRONTEND_URL=http://localhost:5173
# Configuracao de email opcional na inicializacao; necessaria para enviar emails.
# Use "console" localmente; configure "resend" no ambiente de producao.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
# Opcionais: ao iniciar, cria o admin se o email configurado ainda nao existir no banco.
# SUPER_ADMIN_EMAIL tem prioridade sobre ADMIN_EMAIL; mantenha ambos iguais se definidos.
ADMIN_EMAIL=
SUPER_ADMIN_EMAIL=
# Senha inicial com pelo menos 8 caracteres, letras e numeros; nao redefine contas existentes.
ADMIN_PASSWORD=
# Storage / Assinatura adapters (demo: mongo + simple; futuro: r2 + d4sign)
STORAGE_ADAPTER=mongo
ASSINATURA_ADAPTER=simples

# ===== CONFIGURAÇÃO DO ASSISTENTE =====
# Provedor de LLM: openai ou gemini
LLM_PROVIDER=openai
# API Key do OpenAI (começa com sk-)
OPENAI_API_KEY=
# API Key do Gemini (começa com AI)
GEMINI_API_KEY=
# Modelo do OpenAI (padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# URL base do OpenAI (padrão: https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== CONFIGURAÇÃO DO WHATSAPP =====
# Provedor do WhatsApp: evolution ou meta
WHATSAPP_PROVIDER=evolution
# Token da instância do WhatsApp
WHATSAPP_TOKEN=
# Token de verificação do webhook (se aplicável)
WHATSAPP_VERIFY_TOKEN=
# URL do webhook (geralmente preenchida automaticamente em ambientes de nuvem)
WHATSAPP_WEBHOOK_URL=
# ID da empresa padrao para numeros do WhatsApp nao mapeados
DEFAULT_WHATSAPP_EMPRESA_ID=

# ===== CONFIGURAÇÃO DO OLLAMA (PARA INDEXAÇÃO/VETORIZAÇÃO) =====
# URL do serviço Ollama local
OLLAMA_URL=http://127.0.0.1:11434